/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# env
.env
.env.local
.env.*.local

# raw source data (downloaded once during development; generated .ts is committed instead)
data/
